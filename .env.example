# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit secrets.
#
# Generate secrets:
#   openssl rand -hex 32

# Admin API bearer token (minimum 32 characters)
AEGIS_ADMIN_SECRET=

# Redis authentication password
AEGIS_REDIS_PASSWORD=

# JWT shared secret — only needed when auth.enabled=true and jwks_url is empty.
# Prefer JWKS (RSA/ECDSA) for production.
AEGIS_JWT_SECRET=

# PostgreSQL DSN for persistent forensic logs (optional)
# Example: postgres://aegis:pass@pg-host:5432/aegis?sslmode=require
AEGIS_FORENSIC_DSN=

# Outbound alerting webhook (optional) — Slack / PagerDuty / SIEM.
# Overrides alerting.webhook_url from the config file.
AEGIS_ALERT_WEBHOOK_URL=

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=
